             }
             # print(">> dict result", content)
 
+        # (WoW voice-over patch, 2026-10-13) the model sometimes answers valid JSON with the numbers quoted
+        # ({"高兴": "0.3"}); json.loads keeps them as strings and convert() then fails on "'<' not supported between
+        # instances of 'str' and 'float'". Coerce, and drop anything that is not a number.
+        if isinstance(content, dict):
+            def _num(v):
+                try: return float(v)
+                except (TypeError, ValueError): return None
+            content = {k: n for k, n in ((k, _num(v)) for k, v in content.items()) if n is not None}
+
         # workaround for QwenEmotion's inability to distinguish "悲伤" (sad) vs "低落" (melancholic).
